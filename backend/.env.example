APP_ENV=development
APP_NAME="Multi-Document RAG with Citations"
API_V1_PREFIX=/api/v1
DEBUG=true

HOST=0.0.0.0
PORT=8000

DATABASE_URL="sqlite:////Users/vinitkale/Desktop/gen ai/rag_database.db"
VECTOR_STORE=inmemory
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR="/Users/vinitkale/Desktop/gen ai/storage_data"

# Gemini LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-lite
LLM_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

RERANKER_PROVIDER=simple
RERANK_THRESHOLD=0.25
RERANK_TOP_N=8
RETRIEVAL_TOP_K=30

CHUNK_SIZE=700
CHUNK_OVERLAP=100

JWT_SECRET=production_ready_super_secret_key_change_me_in_prod_1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
