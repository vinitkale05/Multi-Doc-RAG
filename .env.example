# ==============================================================================
# Multi-Document RAG with Citations - Environment Variables
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Multi-Document RAG with Citations"
API_V1_PREFIX=/api/v1
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Production Postgres with pgvector: postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
# Local SQLite fallback: sqlite+aiosqlite:///./rag_database.db
DATABASE_URL=sqlite+aiosqlite:///./rag_database.db

# Vector Store (pgvector | inmemory | qdrant)
VECTOR_STORE=inmemory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis Cache and Queue Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (local | s3 | minio)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=rag-docs
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin

# AI / Generation Settings
# Provider options: openai | gemini | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# Embedding Settings
# Provider options: openai | gemini | local | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=your_embedding_api_key_here

# Reranker Settings
# Provider options: cross-encoder | simple | mock
RERANKER_PROVIDER=simple
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=0.35
RERANK_TOP_N=8
RETRIEVAL_TOP_K=30

# Chunking Defaults
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Security & Authentication
JWT_SECRET=production_ready_super_secret_key_change_me_in_prod_1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Quotas and Rate Limits
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=50
MAX_PAGES=500
TOKEN_BUDGET_DAILY=100000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
